# ============================================================================
# Ticket Booking System — environment reference
# Copy the relevant section into packages/api/.env and packages/web/.env
# (or run: cp packages/api/.env.example packages/api/.env && cp packages/web/.env.example packages/web/.env)
# ============================================================================

# ---------------------------------------------------------------------------
# API  (packages/api/.env)
# ---------------------------------------------------------------------------

# PostgreSQL connection. Matches docker-compose.yml (host port 5433).
# If you use a local Postgres on 5432, change the port accordingly.
DATABASE_URL="postgresql://ticket:ticket@localhost:5433/ticketing?schema=public"

# HTTP server port for the API.
PORT=4000

# Secret used to sign JWT auth tokens and QR ticket tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-secret"

# Comma-separated list of allowed CORS origins (the web app URL).
CORS_ORIGIN="http://localhost:5173"

# Public base URL of the WEB app — used to build waitlist offer links inside emails.
APP_BASE_URL="http://localhost:5173"

# Seat hold time-to-live, in seconds (default 10 minutes).
HOLD_TTL_SECONDS=600

# Waitlist offer time-to-live, in seconds (default 10 minutes).
WAITLIST_OFFER_TTL_SECONDS=600

# How often the background sweeper runs to release expired holds/offers, in seconds.
SWEEP_INTERVAL_SECONDS=15

# --- Email (Resend). Leave RESEND_API_KEY empty in dev to use the Ethereal preview transport. ---
RESEND_API_KEY=""
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="Ticket Booking <onboarding@resend.dev>"

# Local external payment simulator.
PAYMENT_API_URL="http://localhost:4100"
PAYMENT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# WEB  (packages/web/.env)
# ---------------------------------------------------------------------------
VITE_API_URL="http://localhost:4000"
VITE_SOCKET_URL="http://localhost:4000"
